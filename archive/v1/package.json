{
  "name": "placeholder-slg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:client": "vite --config src-front/vite.config.ts",
    "dev:server": "tsx watch src-server/index.ts",
    "server": "tsx src-server/index.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --config src-front/vite.config.ts",
    "build-only": "vite build --config src-front/vite.config.ts",
    "type-check": "run-p type-check:client type-check:server",
    "type-check:client": "vue-tsc --build",
    "type-check:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "three": "^0.186.1",
    "vue": "^3.5.28",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.10.13",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
