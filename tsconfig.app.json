{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src-front/**/*", "src-front/**/*.vue", "src-shared/**/*"],
  "exclude": ["src-front/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src-front/*"],
      "@shared/*": ["./src-shared/*"]
    }
  }
}
